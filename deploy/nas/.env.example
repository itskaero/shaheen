# BRAWLISTAN on the NAS. Copy to .env next to docker-compose.yml and fill in.
# Never commit .env. See docs/DEPLOY_NAS.md.

# --- the stack ---------------------------------------------------------------
# Database password: letters and digits only (it goes inside a URL).
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
TUNNEL_TOKEN=
# Where Postgres data and backups live on the NAS (ZimaOS default AppData).
# BRAWLISTAN_DATA=/DATA/AppData/brawlistan
# Pin an image version instead of latest, e.g. ghcr.io/itskaero/shaheen:sha-<full commit sha>
# BRAWLISTAN_IMAGE=ghcr.io/itskaero/shaheen:latest

# --- the bot and the API (same variables as the repo's .env.example) ---------
DISCORD_TOKEN=
DISCORD_GUILD_ID=
BOT_OWNER_ID=
DISCORD_CLIENT_ID=
BRAWLHALLA_API_KEY=
SITE_URL=https://brawlistan.rekorex.online
SETUP_MODE=launch
LOG_LEVEL=INFO
SNAPSHOT_INTERVAL_HOURS=6
# Optional channel overrides (empty = the channels /setup created).
REPORT_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=
