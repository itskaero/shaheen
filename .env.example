# Copy to .env and fill in real values. Never commit .env.

# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# Discord application (client) ID — used for the bot invite link. Optional.
DISCORD_CLIENT_ID=

# The BRAWLISTAN guild (server) ID the bot manages. GUILD_ID also works.
DISCORD_GUILD_ID=

# Your Discord user ID. Always passes staff and /setup checks. Optional.
BOT_OWNER_ID=

# SQLAlchemy async URL. Matches docker-compose's db service by default.
DATABASE_URL=postgresql+asyncpg://shaheen:shaheen@localhost:5432/shaheen

# development | launch — default mode offered by /setup run.
SETUP_MODE=development

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Brawlhalla Developer API key (see docs/DECISIONS.md ADR-022 — request one
# from api@brawlhalla.com and verify current requirements at
# https://dev.brawlhalla.com/ before relying on this).
BRAWLHALLA_API_KEY=

# Optional. Only change this to point at a proxy or test double.
# BRAWLHALLA_API_BASE_URL=https://api.brawlhalla.com/

# The public website, used in links the bot posts.
SITE_URL=https://itskaero.github.io/shaheen

# Optional channel overrides. Leave empty to use the channels /setup created:
# reports and the moderation log go to #report, announcements to
# #announcements (docs/DECISIONS.md ADR-109).
REPORT_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
ANNOUNCEMENT_CHANNEL_ID=

# How often the scheduled ranking/Legend snapshot job runs, in hours.
SNAPSHOT_INTERVAL_HOURS=6

# Optional. The Brawlhalla season is derived from the date — S42 began
# 2026-09-23, one season per 13 weeks after (docs/DECISIONS.md ADR-102).
# Set this only to override that if Brawlhalla's real reset date drifts,
# and unset it again once the calendar catches up.
# BRAWLHALLA_SEASON=42
