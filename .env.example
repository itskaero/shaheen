# Copy to .env and fill in real values. Never commit .env.

# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# The single Shaheen guild (server) ID the bot manages.
GUILD_ID=

# SQLAlchemy async URL. Matches docker-compose's db service by default.
DATABASE_URL=postgresql+asyncpg://shaheen:shaheen@localhost:5432/shaheen

# development | launch — default mode offered by /setup run.
SETUP_MODE=development

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
