# Copy to .env and fill in real values. Never commit .env.

# Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=

# The single Shaheen guild (server) ID the bot manages.
GUILD_ID=

# SQLAlchemy async URL. Matches docker-compose's db service by default.
DATABASE_URL=postgresql+asyncpg://shaheen:shaheen@localhost:5432/shaheen

# development | launch — default mode offered by /setup run.
SETUP_MODE=development

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Brawlhalla Developer API key (see docs/DECISIONS.md ADR-022 — request one
# from api@brawlhalla.com and verify current requirements at
# https://dev.brawlhalla.com/ before relying on this).
BRAWLHALLA_API_KEY=

# How often the scheduled ranking/Legend snapshot job runs, in hours.
SNAPSHOT_INTERVAL_HOURS=6

# The current Brawlhalla ranked season. Every snapshot is stamped with this,
# and leaderboards only rank within the newest season present, so a stale
# pre-reset rating can never outrank a freshly-placed one
# (docs/DECISIONS.md ADR-088). Brawlhalla's API does not report the season,
# so bump this by one on the deploy after each ranked reset.
BRAWLHALLA_SEASON=1
